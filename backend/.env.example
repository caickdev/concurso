APP_NAME="Plataforma de Questões para Concursos"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/concursos
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_ECHO=false
# true força NullPool + statement_cache_size=0 (regime serverless — ver
# database.py). Localmente/em container deixe false; na Vercel é detectado
# automaticamente via VERCEL=1, não precisa setar aqui.
DB_FORCE_NULLPOOL=false

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_FILTERS=300
CACHE_TTL_QUESTION_DETAIL=900
CACHE_TTL_LEADERBOARD=60

JWT_SECRET_KEY=troque-esta-chave-por-um-valor-aleatorio-forte
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=access_token
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

CORS_ORIGINS=http://localhost:5173
# Regex adicional casada contra a Origin do request — por padrão libera
# qualquer preview/produção da Vercel. Deixe vazio para desativar.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app$

RATE_LIMIT_ANSWERS=10/15seconds
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute

AI_PROVIDER_API_KEY=
AI_MODEL_NAME=claude-sonnet-5
AI_REQUEST_TIMEOUT=30

SCRAPER_BATCH_SIZE=200
SCRAPER_CONCURRENCY=5
SCRAPER_USER_AGENT="ConcursosBot/1.0 (+https://example.com/bot)"
# Usadas apenas pelo gatilho HTTP GET /admin/scraper/run (Vercel Cron).
# scripts/run_scraper.py recebe URLs via CLI e ignora estas variáveis.
SCRAPER_SOURCE_URLS=
CRON_SECRET=
