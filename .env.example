# Variáveis de ambiente do deploy na Vercel — configure-as no dashboard do
# projeto (Settings > Environment Variables), separadas por ambiente
# (Production / Preview / Development) quando os valores diferirem.
#
# Para desenvolvimento local do backend fora da Vercel, use
# backend/.env.example (mesmas chaves, valores locais).

# ============================================================
# Frontend (públicas — Vite só expõe ao bundle o que começa com VITE_)
# ============================================================
# Deixe em branco/omita para deploy unificado (frontend + api no mesmo
# projeto Vercel, roteado via rewrites em vercel.json — chamadas relativas
# "/api/v1/..." já funcionam sem esta variável). Defina apenas se o frontend
# for publicado como projeto Vercel separado do backend.
#
# ATENÇÃO ao usar deploy separado: cada subdomínio *.vercel.app conta como um
# "site" distinto para fins de cookie (vercel.app está na Public Suffix List),
# ou seja, a chamada ao backend é cross-site. Com COOKIE_SAMESITE=strict
# (padrão) o navegador NUNCA envia o cookie de sessão nesse cenário — o login
# vai parecer funcionar mas nenhuma rota autenticada vai reconhecer o usuário.
# Se optar por deploy separado, ajuste no projeto do BACKEND:
#   COOKIE_SAMESITE=none   (exige COOKIE_SECURE=true, já é o padrão)
# Isso reabre superfície de CSRF que o SameSite=strict fechava — prefira o
# deploy unificado (mesma origem) sempre que possível.
VITE_API_URL=

# ============================================================
# Backend — Banco de Dados
# ============================================================
# Em produção na Vercel, aponte para a connection string COM PGBOUNCER do
# provedor (obrigatório em ambiente serverless — ver database.py):
#   Neon:     host com sufixo "-pooler" (porta 5432) ou porta 6543
#   Supabase: "Connection pooling" > modo "Transaction" (porta 6543)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx-pooler.region.aws.neon.tech/concursos
# Forma alternativa/explícita de habilitar o regime serverless (NullPool +
# statement_cache_size=0) em provedores que não expõem VERCEL=1.
DB_FORCE_NULLPOOL=true

# ============================================================
# Backend — Redis / Cache
# ============================================================
REDIS_URL=rediss://default:password@your-redis-provider.upstash.io:6379

# ============================================================
# Backend — Segurança / JWT
# ============================================================
JWT_SECRET_KEY=troque-esta-chave-por-um-valor-aleatorio-forte
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# Necessário se o cookie de auth precisar ser compartilhado entre subdomínios
# (ex.: api.seudominio.com e app.seudominio.com). Deixe em branco no *.vercel.app.
COOKIE_DOMAIN=

# ============================================================
# Backend — CORS
# ============================================================
# Domínios fixos adicionais (produção com domínio customizado, dev local).
# Previews *.vercel.app já são liberados automaticamente via CORS_ORIGIN_REGEX
# (backend/core/config.py) — não é necessário listá-los aqui.
CORS_ORIGINS=https://seu-dominio-de-producao.com,http://localhost:5173

# ============================================================
# Backend — Tutor IA
# ============================================================
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=claude-sonnet-5

# ============================================================
# Backend — Cron (Vercel Cron Jobs -> GET /api/v1/admin/scraper/run)
# ============================================================
# Defina esta variável no projeto Vercel: ela injeta automaticamente o header
# "Authorization: Bearer <CRON_SECRET>" nas chamadas agendadas (ver vercel.json
# -> "crons" e backend/routers/admin.py).
CRON_SECRET=gere-um-valor-aleatorio-forte
# Fontes usadas pelo gatilho de cron (lotes pequenos). Para volumes maiores,
# use scripts/run_scraper.py fora da Vercel.
SCRAPER_SOURCE_URLS=
